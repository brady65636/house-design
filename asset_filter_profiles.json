    "chroma_band": "Coarse saturation band: low, medium, or high.",
    "value_band": "Dominant lightness band: light, medium, dark, or mixed.",
    "activity": "Combined Base Color, Normal/Height, motif scale, and catalog-spread activity: low, medium, or high.",
    "scale": "Dominant motif/module scale: none, micro, small, medium, large, or mural.",
    "direction": "Dominant directional grammar: none, vertical, horizontal, grid, organic, or mixed.",
    "direction_strength": "Whether direction is visually weak or strong.",
    "material_language": "Coarse bucket used only to preserve diversity after vetoes.",
    "requires_continuous_target": "True only when cropping by doors/windows would obviously break the intended composition."
  },
