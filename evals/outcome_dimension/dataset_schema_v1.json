{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "outcome_dataset_v1",
  "type": "object",
  "properties": {
    "dataset_version": {"const": "outcome_dataset_v1"},
    "rubric_version": {"const": "outcome_dimension_v1"},
    "entry_contract": {
      "type": "object",
      "properties": {
        "mode": {"const": "fixed_approved_plan"},
        "message_template": {"type": "string", "minLength": 1}
      },
      "required": ["mode", "message_template"],
      "additionalProperties": false
    },
    "subsets": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {"type": "string"},
        "uniqueItems": true
      }
    },
    "scenarios": {
      "type": "array",
      "minItems": 12,
      "items": {
        "type": "object",
        "properties": {
          "scenario_id": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "tags": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "confirmed_requirements": {
            "type": "array",
            "items": {"type": "string"},
            "minItems": 1
          },
          "approved_plan": {"type": "string", "minLength": 1},
          "allowed_room_ids": {
            "type": "array",
            "items": {"type": "string"},
            "minItems": 1,
            "uniqueItems": true
          },
          "allowed_target_ids": {
            "type": "array",
            "items": {"type": "string"},
            "minItems": 1,
            "uniqueItems": true
          },
          "required_visual_criteria": {
            "type": "array",
            "items": {"type": "string"},
            "minItems": 1,
            "uniqueItems": true
          },
          "capture_plan": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "capture_id": {"type": "string", "minLength": 1},
                "tool": {"enum": ["observe_room", "observe_home_harmony"]},
                "room_id": {"type": "string"},
                "focus_target_ids": {
                  "type": "array",
                  "items": {"type": "string"},
                  "uniqueItems": true
                },
                "minimum_image_count": {"type": "integer", "minimum": 1},
                "covers_criteria": {
                  "type": "array",
                  "items": {"type": "string"},
                  "minItems": 1,
                  "uniqueItems": true
                }
              },
              "required": ["capture_id", "tool", "minimum_image_count", "covers_criteria"],
              "additionalProperties": false
            }
          },
          "grader_focus": {"type": "string", "minLength": 1}
        },
        "required": [
          "scenario_id", "title", "tags", "confirmed_requirements", "approved_plan",
          "allowed_room_ids", "allowed_target_ids", "required_visual_criteria",
          "capture_plan", "grader_focus"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": ["dataset_version", "rubric_version", "entry_contract", "subsets", "scenarios"],
  "additionalProperties": false
}
