{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "outcome_evidence_packet_v1",
  "type": "object",
  "properties": {
    "scenario_id": {"type": "string", "minLength": 1},
    "rubric_version": {"const": "outcome_dimension_v1"},
    "confirmed_requirements": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "approved_plan": {"type": "string", "minLength": 1},
    "allowed_target_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "baseline_provenance": {
      "type": "object",
      "properties": {
        "source": {"const": "deepseek_user_simulator_close"},
        "simulator_model": {"const": "deepseek-v4-flash"},
        "close_token": {"const": "CLOSE"},
        "close_decision_index": {"type": "integer", "minimum": 1},
        "initial_message": {"type": "string", "minLength": 1},
        "negotiation_log": {"type": "array", "items": {"type": "object"}},
        "plan_approval_log": {"type": "array", "minItems": 1, "items": {"type": "object"}}
      },
      "required": [
        "source", "simulator_model", "close_token", "close_decision_index",
        "initial_message", "negotiation_log", "plan_approval_log"
      ],
      "additionalProperties": false
    },
    "required_visual_criteria": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
    "capture_plan": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "capture_id": {"type": "string"},
          "tool": {"enum": ["observe_room", "observe_home_harmony"]},
          "room_id": {"type": "string"},
          "focus_target_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "minimum_image_count": {"type": "integer", "minimum": 1},
          "covers_criteria": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true}
        },
        "required": ["capture_id", "tool", "minimum_image_count", "covers_criteria"],
        "additionalProperties": false
      }
    },
    "base_state": {
      "type": "object",
      "properties": {
        "design_run_id": {"type": "string"},
        "scheme_version_id": {"type": "string"},
        "scheme": {"type": "object"}
      },
      "required": ["design_run_id", "scheme_version_id", "scheme"],
      "additionalProperties": false
    },
    "final_state": {
      "type": "object",
      "properties": {
        "design_run_id": {"type": "string"},
        "scheme_version_id": {"type": "string"},
        "scheme": {"type": "object"},
        "validator_passed": {"type": "boolean"}
      },
      "required": ["design_run_id", "scheme_version_id", "scheme", "validator_passed"],
      "additionalProperties": false
    },
    "scheme_diff": {"type": "array", "items": {"type": "object"}},
    "tool_calls": {"type": "array", "items": {"type": "object"}},
    "render_evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "evidence_id": {"type": "string"},
          "capture_id": {"type": "string"},
          "view_id": {"type": "string"},
          "design_run_id": {"type": "string"},
          "scheme_version_id": {"type": "string"},
          "room_id": {"type": "string"},
          "view_label": {"type": "string"},
          "image_path": {"type": "string"},
          "evidence_valid": {"type": "boolean"},
          "observation_status": {"enum": ["ready", "incomplete_observation", "unknown"]},
          "quality": {"type": ["object", "null"]},
          "target_visibility": {"type": "array", "items": {"type": "object"}},
          "mask_quality": {"type": ["object", "null"]}
        },
        "required": ["evidence_id", "capture_id", "view_id", "design_run_id", "scheme_version_id", "room_id", "view_label", "image_path", "evidence_valid", "observation_status", "quality", "target_visibility", "mask_quality"],
        "additionalProperties": false
      }
    },
    "critic_review": {"type": ["string", "null"]},
    "final_report": {"type": "string"}
  },
  "required": [
    "scenario_id", "rubric_version", "confirmed_requirements", "approved_plan",
    "baseline_provenance",
    "allowed_target_ids", "required_visual_criteria", "capture_plan", "base_state", "final_state",
    "scheme_diff", "tool_calls", "render_evidence", "critic_review", "final_report"
  ],
  "additionalProperties": false
}
