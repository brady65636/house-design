# 1GB VPS 生产环境变量模板
# 用法：cp .env.example .env 后逐项填写，.env 会被 docker compose 读取（已 gitignore）。

# --- 模型（跟本地 .env 保持一致；服务器上不设 OPENAI_PROXY 即直连） ---
OPENAI_API_KEY=sk-...
# 如果你用兼容网关/DeepSeek 等，改成对应地址，如 https://api.deepseek.com/v1
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.6-luna

# --- CORS：必须包含你的 Vercel 前端域名（浏览器直连 agent-api 和 render-bridge） ---
# 多个源用英文逗号分隔
CORS_ORIGINS=https://my-house.vercel.app

# --- 鉴权：随机生成，例如 openssl rand -hex 24 ---
AGENT_API_TOKEN=openssl-rand-hex-24

# --- 其他（一般不用改） ---
# VIEWER_URL 本方案不设：render-worker 不跑，前端在 Vercel，用户浏览器直接当渲染会话。
