# 1GB VPS 生产环境变量模板
# 用法：cp .env.example .env 后逐项填写，.env 会被 docker compose 读取（已 gitignore）。

# --- 模型（项目专属命名空间，不读取系统级 OPENAI_* / DEEPSEEK_*） ---
HOUSE_DESIGN_LLM_PROVIDER=openai
HOUSE_DESIGN_OPENAI_API_KEY=sk-...
# OpenAI provider 只允许官方 HTTPS API；兼容网关必须实现为独立 provider。
HOUSE_DESIGN_OPENAI_BASE_URL=https://api.openai.com/v1
HOUSE_DESIGN_OPENAI_MODEL=gpt-5.6-luna
HOUSE_DESIGN_REASONING_EFFORT=none

# --- LangSmith（可选；启用后记录 Agent/LLM/工具/Critic trace） ---
HOUSE_DESIGN_LANGSMITH_TRACING=false
HOUSE_DESIGN_LANGSMITH_API_KEY=lsv2_...
HOUSE_DESIGN_LANGSMITH_ENDPOINT=https://api.smith.langchain.com
HOUSE_DESIGN_LANGSMITH_PROJECT=house-design-agent
# API key 关联多个 workspace 时才需要填写。
HOUSE_DESIGN_LANGSMITH_WORKSPACE_ID=

# --- CORS：必须包含你的 Vercel 前端域名（浏览器直连 agent-api 和 render-bridge） ---
# 多个源用英文逗号分隔
CORS_ORIGINS=https://my-house.vercel.app

# --- 鉴权：随机生成，例如 openssl rand -hex 24 ---
AGENT_API_TOKEN=openssl-rand-hex-24

# --- 其他（一般不用改） ---
# VIEWER_URL 本方案不设：render-worker 不跑，前端在 Vercel，用户浏览器直接当渲染会话。
